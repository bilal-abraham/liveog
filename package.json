{
  "name": "liveog",
  "version": "0.1.1",
  "description": "Link previews that stay current: Open Graph tags, covers drawn by a browser you already run, versioned cover addresses, privacy per link kind.",
  "keywords": [
    "open graph",
    "og",
    "link preview",
    "twitter card",
    "og image",
    "mcp"
  ],
  "license": "MIT",
  "author": "Bilal Abraham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilal-abraham/liveog.git"
  },
  "homepage": "https://bilal-abraham.github.io/liveog/",
  "bugs": "https://github.com/bilal-abraham/liveog/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./draw": {
      "types": "./dist/draw.d.ts",
      "default": "./dist/draw.js"
    },
    "./study": {
      "types": "./dist/study.d.ts",
      "default": "./dist/study.js"
    }
  },
  "bin": {
    "liveog": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test 'dist/*.test.js'",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
